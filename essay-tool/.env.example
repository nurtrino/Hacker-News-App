# --- Required ---

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Password to access the app (you choose this — single user)
APP_PASSWORD=change-me-to-something-long

# Secret used to sign the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-32-byte-random-hex-string

# SQLite database location. For local dev the default below is fine.
# When deploying, point this at a file on a persistent volume,
# e.g. file:/data/essays.db
DATABASE_URL="file:./dev.db"

# --- Optional ---

# LanguageTool API endpoint. Defaults to the free public API.
# For heavy use, self-host LanguageTool and set this to your instance,
# e.g. http://localhost:8081/v2/check
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
